# docs/ is the pages' one folder (since 30 Sep 2026). The repo is public, so git keeps
# only its page groups (PAGE_GROUPS in docs/tools/to-docs.mjs), the index and the tools:
# anything else in it stays on this Mac, docs/private/ above all (memory-about-you,
# design examples, morning briefs, Gemma run files) and any new folder or loose page.
# `bun run docs` and `bun run check` fail if a file outside these is ever tracked.
docs/*
!docs/README.md
!docs/tools/
!docs/diagrams/
!docs/reports/
!docs/tests/
!docs/design rounds/
!docs/other/
!docs/older versions/
!docs/gemma-docs/
# The code map of this repo (bun run codemap, terminal/src/tools/codemap.mjs): not pages, for the models.
!docs/map/
# The pages' old folder names (before 30 Sep 2026): still ignored if one is left over
cli docs/
agentic-coder DOCS/
bonsai-code DOCS/
# Reading material kept beside the repo, never committed
CLAUDE MODEL DOCS/

# Part 1 · terminal: capture and UI-walk outputs are scratch (one script rebuilds them)
terminal/scripts/capture-*.json
terminal/scripts/*.log
terminal/scripts/.captures-done
terminal/scripts/ui-walk-*.json
terminal/ui-walk/

# Part 2 · models: raw test runs stay on this Mac (one results/ per model);
# the report pages live in docs/.
models/*/results/
models/evals/dev/experiments/slots/
models/evals/dev/experiments/*.log
# The matcher experiment for memory (rejected): its files stay on this Mac
models/evals/dev/experiments/julia-recall/
models/evals/dev/experiments/*/*.log
__pycache__/
