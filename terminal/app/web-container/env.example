# Copy to .env (next to compose.yml) and fill in. .env stays on the server: never commit it.
#
# The web address: your server's IP with dashes at sslip.io (a free name that already points at
# it), e.g. 203-0-113-7.sslip.io. Both lines take the same value.
WEB_HOST=
AGENTIC_WEB_SERVER=
#
# Your Ollama services, comma-separated, as the container reaches them. On the same server use
# host.docker.internal and the port, e.g. http://host.docker.internal:11434
AGENTIC_AI_URLS=
# Your calculator the same way, e.g. http://host.docker.internal:8080
AGENTIC_CALC_URL=
